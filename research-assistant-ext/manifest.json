{
  "name": "Research Assistant",
  "description": "A Research Assistant with AI powered",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel",
    "scripting"
  ],
  "action": {
    "default_title": "Research Assistant",
    "default_popup": "./html/sidepanel.html",
    "default_icon": "./img/hello_extensions.png"
  },
  "side_panel": {
    "default_path": "./html/sidepanel.html"
  },
  "background":{
    "service_worker": "./js/background.js"
  },
  "host_permissions": [
    "http://localhost:8080/*",
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self' "
  }
}
