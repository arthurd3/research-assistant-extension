{
  "name": "Research Assistant",
  "description": "A Research Assistant with AI powered",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel",
    "scripting"
  ],
  "action": {
    "default_title": "Research Assistant",
    "default_popup": "hello.html",
    "default_icon": "hello_extensions.png"
  },
  "side_panel": {
    "default_title":"sidepanel.html"
  },
  "background":{
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://localhost:8080/*",
    "<all_urls>"
  ]
}
